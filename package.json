{
  "name": "devops-lab",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "wrangler dev",
    "deploy": "astro build && wrangler d1 migrations apply devops-lab --remote && wrangler deploy",
    "db:local": "wrangler d1 migrations apply devops-lab --local",
    "db:remote": "wrangler d1 migrations apply devops-lab --remote",
    "check": "astro check",
    "test": "node --test tests/*.test.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "latest",
    "@astrojs/cloudflare": "^14.4.3",
    "@fontsource-variable/inter": "5.2.8",
    "alasql": "^4.22.0",
    "astro": "^7.4.4"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "latest",
    "wrangler": "^4.156.0"
  },
  "pnpm": {
    "overrides": {
      "react-native-fs": "-"
    }
  }
}
