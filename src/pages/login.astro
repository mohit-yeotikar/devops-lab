---
import Base from '../layouts/Base.astro';
import LoginCard from '../components/LoginCard.astro';
import AuthShell from '../components/AuthShell.astro';
if (Astro.locals.user) return Astro.redirect('/app');
const next = Astro.url.searchParams.get('next') || '/app';
---
<Base title="Log in"><AuthShell><LoginCard next={next} /></AuthShell></Base>
