---
import Base from '../layouts/Base.astro';
if (Astro.locals.user) return Astro.redirect('/app');
const next = Astro.url.searchParams.get('next') || '/app';
---
<Base title="Log in">
  <div class="card" style="max-width:420px;margin:30px auto">
    <h1>Welcome back</h1>
    <form data-api action="/api/auth/login" method="post">
      <input type="hidden" name="next" value={next} />
      <label>Email</label><input name="email" type="email" required autocomplete="email" />
      <label>Password</label><input name="password" type="password" required autocomplete="current-password" />
      <div class="out"></div>
      <p><button class="btn" type="submit">Log in</button></p>
    </form>
    <p class="help">New here? <a href="/signup">Create a free account</a></p>
  </div>
</Base>
