---
import '@fontsource-variable/inter';
import '../styles/app.css';
import { env } from '../lib/env';
interface Props { title: string; description?: string }
const { title, description = 'Practice real DevOps work. Build a portfolio. Get ready for interviews.' } = Astro.props;
const user = Astro.locals.user;
const path = Astro.url.pathname;
const on = (p: string) => (path === p || (p !== '/app' && path.startsWith(p)) ? 'on' : '');
const appName = env.APP_NAME ?? 'DevOps Lab';
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title} · {appName}</title>
  <meta name="description" content={description} />
  <meta name="theme-color" content="#f7f7f6" />
  <link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><rect width='100' height='100' rx='22' fill='%2317181b'/><text y='70' x='50' text-anchor='middle' font-size='58' font-family='sans-serif' font-weight='600' fill='white'>D</text></svg>" />
  <script is:inline>
    // Light is the default. Dark only when the person chose it with the header toggle.
    try { if (localStorage.getItem('theme') === 'dark') document.documentElement.dataset.theme = 'dark'; } catch {}
  </script>
</head>
<body>
  <a class="skip" href="#main">Skip to content</a>
  <header class="top"><div class="wrap">
    <a class="logo" href={user ? '/app' : '/'}><i>D</i> {appName}</a>
    <nav aria-label="Main">
      {user ? (<>
        <a href="/app" class={on('/app')}>Home</a>
        <a href="/app/sprints" class={on('/app/sprints')}>Sprints</a>
        <a href="/app/practice" class={on('/app/practice')}>Practice</a>
        <a href="/app/drills" class={on('/app/drills')}>Incidents</a>
        <a href="/app/interview" class={on('/app/interview')}>Interview</a>
        <a href="/app/log" class={on('/app/log')}>Work log</a>
        <a href={`/u/${user.handle}`}>Portfolio</a>
        {user.role === 'admin' && <a href="/admin" class={on('/admin')}>Admin</a>}
        <a href="/app/profile" class={on('/app/profile')}>{user.name.split(' ')[0]}</a>
      </>) : null}
    </nav>
    <button class="theme" type="button" aria-label="Switch between light and dark" title="Light / dark">
      <svg class="sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
      <svg class="moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"/></svg>
    </button>
  </div></header>
  <main id="main"><div class="wrap"><slot /></div></main>
  {user && <footer><div class="wrap">{appName} · Practice environment for DevOps trainees. Every hour you log here is real work you did.</div></footer>}
  <script>
    // Theme toggle (light ↔ dark), remembered per browser.
    document.querySelector<HTMLButtonElement>('.theme')?.addEventListener('click', () => {
      const dark = document.documentElement.dataset.theme !== 'dark';
      if (dark) document.documentElement.dataset.theme = 'dark'; else delete document.documentElement.dataset.theme;
      try { localStorage.setItem('theme', dark ? 'dark' : 'light'); } catch {}
    });
    // Tabs + generic fetch forms (data-api). Keeps pages dependency-free.
    document.querySelectorAll('.tabs').forEach((t) => {
      const btns = t.querySelectorAll('button'); const panes = t.parentElement!.querySelectorAll(':scope > .tab');
      btns.forEach((b, i) => b.addEventListener('click', () => { btns.forEach((x) => x.classList.remove('on')); panes.forEach((x) => x.classList.remove('on')); b.classList.add('on'); panes[i]?.classList.add('on'); }));
    });
    document.querySelectorAll<HTMLFormElement>('form[data-api]').forEach((f) => {
      f.addEventListener('submit', async (e) => {
        e.preventDefault();
        const btn = f.querySelector<HTMLButtonElement>('button[type=submit]'); if (btn) btn.disabled = true;
        const out = f.querySelector('.out') || document.getElementById(f.dataset.out || '');
        try {
          const r = await fetch(f.action, { method: 'POST', body: new FormData(f) });
          const j = await r.json().catch(() => ({}));
          if (!r.ok) { if (out) out.innerHTML = `<div class="notice warn">${j.error || 'Something went wrong.'}</div>`; return; }
          if (j.redirect) { location.href = j.redirect; return; }
          if (j.reload) { location.reload(); return; }
          if (out && j.html) out.innerHTML = j.html;
          f.dispatchEvent(new CustomEvent('api:done', { detail: j }));
        } finally { if (btn) btn.disabled = false; }
      });
    });
  </script>
</body>
</html>
