---
interface Props { next?: string }
const { next = '/app' } = Astro.props;
---
<div class="auth">
  <h1>Log in</h1>
  <p class="sub">DevOps Lab training. Use the email and password you signed up with.</p>
  <form data-api action="/api/auth/login" method="post">
    <input type="hidden" name="next" value={next} />
    <label for="email">Email</label><input id="email" name="email" type="email" required autocomplete="email" />
    <label for="password">Password</label><input id="password" name="password" type="password" required autocomplete="current-password" />
    <div class="out"></div>
    <button class="btn wide" type="submit">Log in</button>
  </form>
  <p class="help center">New trainee? <a href="/signup">Create your account</a></p>
</div>
